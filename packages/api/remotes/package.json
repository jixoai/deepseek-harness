{
  "name": "@fde2e/len-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@fde2e/len-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@fde2e/len-deque": "workspace:*",
    "@fde2e/len-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-scope": "workspace:*"
  },
  "devDependencies": {
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-preset-registry": "workspace:*",
    "@fde2e/len-api-gateway": "workspace:*",
    "@fde2e/len-api-job-controller": "workspace:*",
    "@fde2e/len-api-session-controller": "workspace:*",
    "@fde2e/len-api-settings-controller": "workspace:*",
    "@fde2e/len-api-workspace-controller": "workspace:*",
    "@fde2e/len-api-workspace-files": "workspace:*",
    "@fde2e/len-client-connection": "workspace:*",
    "@fde2e/len-client-file-upload": "workspace:*",
    "@fde2e/len-commands": "workspace:*",
    "@fde2e/len-cordis-host-runner": "workspace:*",
    "@fde2e/len-credentials": "workspace:*",
    "@fde2e/len-file-reference": "workspace:*",
    "@fde2e/len-goal": "workspace:*",
    "@fde2e/len-host-plugin-inventory": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-message-feedback": "workspace:*",
    "@fde2e/len-permission-presets": "workspace:*",
    "@fde2e/len-schedule": "workspace:*",
    "@fde2e/len-scope": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-reference": "workspace:*",
    "@fde2e/len-settings": "workspace:*",
    "@fde2e/len-subagent": "workspace:*",
    "@fde2e/len-typert-protocol": "workspace:*",
    "@fde2e/len-user-approval": "workspace:*",
    "@fde2e/len-user-questions": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "zod": "4.4.3",
    "@fde2e/len-command-feedback": "workspace:*",
    "@fde2e/len-api-terminal-controller": "workspace:*",
    "@fde2e/len-plugin-manager": "workspace:*",
    "@fde2e/len-mcp-manager": "workspace:*",
    "@fde2e/len-plugin-market": "workspace:*",
    "@fde2e/len-client-ui-plugin-manager": "workspace:*",
    "@fde2e/len-office-to-pdf": "workspace:*",
    "@fde2e/len-api-account-controller": "workspace:*",
    "@fde2e/len-deepseek-account": "workspace:*",
    "@fde2e/len-client-product-analytics": "workspace:*",
    "@fde2e/len-agent-team": "workspace:*",
    "@fde2e/len-client-ui-trajectory": "workspace:*",
    "@fde2e/len-web": "workspace:*"
  }
}
