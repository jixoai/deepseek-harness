    "@fde2e/len-client-file-upload": "workspace:*",
    "@fde2e/len-commands": "workspace:*",
    "@fde2e/len-credentials": "workspace:*",
    "@fde2e/len-file-reference": "workspace:*",
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-native-command": "workspace:*",
    "@fde2e/len-scope": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-persistence": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-session-projection-cache": "workspace:*",
    "@fde2e/len-session-query": "workspace:*",
    "@fde2e/len-session-title": "workspace:*",
    "@fde2e/len-settings": "workspace:*",
    "@fde2e/len-skill": "workspace:*",
    "@fde2e/len-subagent": "workspace:*",
    "@fde2e/len-typert-protocol": "workspace:*",
    "@fde2e/len-typert-registry": "workspace:*",
    "@fde2e/len-util-time": "workspace:*",
    "@fde2e/len-util-values": "workspace:*",
    "@fde2e/len-util-workspace-path": "workspace:*",
    "@fde2e/len-workspace": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
