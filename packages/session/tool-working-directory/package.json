{
  "name": "@fde2e/len-tool-working-directory",
  "description": "Read and change the active Session working directory",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/tool-working-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-fs-local": "workspace:*",
    "@fde2e/len-agent-loop": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*"
  }
}
