{
  "name": "@fde2e/len-experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "cua-helper.json",
    "native/Package.swift",
    "native/Info.plist",
    "native/DSHComputerUse.icns",
    "native/build_app.py",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/LICENSE.computer-use-icon",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-computer-use": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-user-questions": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@fde2e/len-atomic-write": "workspace:*",
    "@fde2e/len-cua": "workspace:*"
  },
  "devDependencies": {
    "@fde2e/len-working-directory": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-attachment": "workspace:*",
    "@fde2e/len-attachment-local": "workspace:*",
    "@fde2e/len-computer-use": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-tool-executor-native": "workspace:*",
    "@fde2e/len-tool-executor-ptc": "workspace:*",
    "@fde2e/len-tool-testkit": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-subprocess-local": "workspace:*",
    "@fde2e/len-fs-local": "workspace:*",
    "@fde2e/len-llm-deepseek": "workspace:*",
    "@fde2e/len-ptc-runtime-node": "workspace:*",
    "@fde2e/len-sandbox-local": "workspace:*",
    "@fde2e/len-sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@fde2e/len-ptc-runtime": "workspace:*",
    "@fde2e/len-user-questions": "workspace:*",
    "@fde2e/len-settings": "workspace:*",
    "@fde2e/len-app-boot": "workspace:*",
    "@fde2e/len-config-editor": "workspace:*",
    "@fde2e/len-hmr": "workspace:*",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@fde2e/len-storage": "workspace:*",
    "@fde2e/len-storage-json": "workspace:*",
    "@fde2e/len-storage-domain": "workspace:*"
  },
  "scripts": {
    "build:native": "xcrun python3 native/build_app.py",
    "build:icon": "node native/generate_icon.mjs"
  },
  "os": [
    "darwin"
  ]
}
