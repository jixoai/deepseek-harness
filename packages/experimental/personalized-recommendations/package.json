{
  "name": "@fde2e/len-personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.2-alpha.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@fde2e/len-action-cards": "workspace:*",
    "@fde2e/len-client-ui-action-cards": "workspace:*",
    "@fde2e/len-creation-recommendations": "workspace:*",
    "@fde2e/len-client-ui-creation-recommendations": "workspace:*",
    "@fde2e/len-plugin-recommendations": "workspace:*",
    "@fde2e/len-client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-api-remote-access": "workspace:*",
    "@fde2e/len-app-boot": "workspace:*",
    "@fde2e/len-hmr": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-plugin-manager": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-skill": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-tool-executor-native": "workspace:*",
    "@fde2e/len-tools": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
