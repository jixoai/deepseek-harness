{
  "name": "@fde2e/len-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the DeepSeek Harness Auto permission preset",
  "version": "0.2.2-alpha.3",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-instructions": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-permission-presets": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-working-directory": "workspace:*"
  },
  "dependencies": {
    "@fde2e/len-util-values": "workspace:*"
  },
  "devDependencies": {
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-instructions": "workspace:*",
    "@fde2e/len-agent-loop": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-bash-sandbox": "workspace:*",
    "@fde2e/len-compaction": "workspace:*",
    "@fde2e/len-fs-local": "workspace:*",
    "@fde2e/len-fs-observation-policy": "workspace:*",
    "@fde2e/len-fs-sandbox": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-llm-deepseek": "workspace:*",
    "@fde2e/len-llm-deepseek-api-key": "workspace:*",
    "@fde2e/len-permission-presets": "workspace:*",
    "@fde2e/len-ptc-runtime-node": "workspace:*",
    "@fde2e/len-sandbox": "workspace:*",
    "@fde2e/len-sandbox-policy": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-shell": "workspace:*",
    "@fde2e/len-shell-env": "workspace:*",
    "@fde2e/len-subagent": "workspace:*",
    "@fde2e/len-subprocess-local": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-tool-bash": "workspace:*",
    "@fde2e/len-tool-executor-native": "workspace:*",
    "@fde2e/len-tool-executor-ptc": "workspace:*",
    "@fde2e/len-tool-fs": "workspace:*",
    "@fde2e/len-tool-subagent": "workspace:*",
    "@fde2e/len-tool-testkit": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-user-approval": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
