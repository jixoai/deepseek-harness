{
  "name": "@fde2e/len-experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@fde2e/len-timeout": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-sandbox": "workspace:*",
    "@fde2e/len-sandbox-policy": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-fs-local": "workspace:*",
    "@fde2e/len-sandbox": "workspace:*",
    "@fde2e/len-sandbox-local": "workspace:*",
    "@fde2e/len-sandbox-policy": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-subprocess-local": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*"
  }
}
