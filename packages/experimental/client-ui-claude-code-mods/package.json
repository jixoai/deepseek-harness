{
  "name": "@fde2e/len-experimental-client-ui-claude-code-mods",
  "description": "Web band above the prompt for Claude Code mods: draws each session's mod tree and sends button presses back to the bridge",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/client-ui-claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@fde2e/len-api-remotes",
        "@fde2e/len-api-session-controller",
        "@fde2e/len-client-locale",
        "@fde2e/len-client-ui-conversation",
        "@fde2e/len-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-api-remotes": "workspace:*",
    "@fde2e/len-api-session-controller": "workspace:*",
    "@fde2e/len-client-locale": "workspace:*",
    "@fde2e/len-client-test-runtime": "workspace:*",
    "@fde2e/len-client-ui-conversation": "workspace:*",
    "@fde2e/len-client-ui-primitives": "workspace:*",
    "@fde2e/len-client-ui-renderer": "workspace:*",
    "@fde2e/len-client-ui-session": "workspace:*",
    "@fde2e/len-client-ui-slots": "workspace:*",
    "@fde2e/len-experimental-claude-code-mods": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-typert-protocol": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
