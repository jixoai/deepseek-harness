{
  "name": "@fde2e/len-hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the DeepSeek Harness interception seams",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-hook-protocol": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-shell": "workspace:*",
    "@fde2e/len-bash-local": "workspace:*",
    "@fde2e/len-subprocess-local": "workspace:*",
    "@fde2e/len-hook-protocol": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-persistence-jsonl": "workspace:*",
    "@fde2e/len-tool-testkit": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*"
  }
}
