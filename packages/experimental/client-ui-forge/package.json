{
  "name": "@fde2e/len-experimental-client-ui-forge",
  "description": "Sidebar panel for a Session's change requests, with a worktree option for new Sessions and its Host Remote",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/client-ui-forge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@fde2e/len-api-remotes",
        "@fde2e/len-client-locale",
        "@fde2e/len-client-ui-conversation",
        "@fde2e/len-client-ui-layout",
        "@fde2e/len-client-ui-sidebar-right",
        "@fde2e/len-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-experimental-worktree": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-timeout": "workspace:*",
    "@fde2e/len-experimental-forge": "workspace:*",
    "@fde2e/len-fs": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@fde2e/len-util-values": "workspace:*",
    "diff": "^9.0.0",
    "zod": "^4.4.3",
    "@fde2e/len-typert-protocol": "workspace:*",
    "@fde2e/len-storage-domain": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-api-remotes": "workspace:*",
    "@fde2e/len-api-session-controller": "workspace:*",
    "@fde2e/len-client-locale": "workspace:*",
    "@fde2e/len-client-store": "workspace:*",
    "@fde2e/len-client-test-runtime": "workspace:*",
    "@fde2e/len-client-ui-conversation": "workspace:*",
    "@fde2e/len-client-ui-layout": "workspace:*",
    "@fde2e/len-client-ui-primitives": "workspace:*",
    "@fde2e/len-client-ui-renderer": "workspace:*",
    "@fde2e/len-client-ui-session": "workspace:*",
    "@fde2e/len-client-ui-sidebar-right": "workspace:*",
    "@fde2e/len-client-ui-slots": "workspace:*",
    "@fde2e/len-client-ui-workspace": "workspace:*",
    "@fde2e/len-experimental-forge": "workspace:*",
    "@fde2e/len-experimental-forge-session": "workspace:*",
    "@fde2e/len-experimental-worktree": "workspace:*",
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-fs-local": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-sandbox": "workspace:*",
    "@fde2e/len-sandbox-local": "workspace:*",
    "@fde2e/len-sandbox-policy": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-subprocess-local": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-util-workspace-path": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@fde2e/len-timeout": "workspace:*",
    "@fde2e/len-session-projection-cache": "workspace:*",
    "@fde2e/len-session-query": "workspace:*",
    "@fde2e/len-api-remote-access": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
