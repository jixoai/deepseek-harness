{
  "name": "@fde2e/len-llm-retry",
  "description": "Provider-routed LLM request retry policy for the FDE2E LEN",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@fde2e/len-brand": "workspace:*",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-timeout": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-session-projection": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fde2e/len-brand": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-llm-deepseek": "workspace:*",
    "@fde2e/len-llm-deepseek-api-key": "workspace:*",
    "@fde2e/len-llm-mock-server": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-session-persistence-jsonl": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-timeout": "workspace:*",
    "@fde2e/len-tool-executor-native": "workspace:*",
    "@fde2e/len-tool-testkit": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
