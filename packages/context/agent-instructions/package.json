{
  "name": "@fde2e/len-agent-instructions",
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/agent-instructions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-home-paths": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*"
  },
  "dependencies": {
    "@fde2e/len-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-fs-local": "workspace:*",
    "@fde2e/len-home-paths": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-llm-deepseek": "workspace:*",
    "@fde2e/len-llm-deepseek-api-key": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-tool-executor-native": "workspace:*",
    "@fde2e/len-tool-fs": "workspace:*",
    "@fde2e/len-tool-testkit": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*"
  }
}
