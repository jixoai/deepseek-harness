    "@fde2e/len-session": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-session-projection": "workspace:*"
  },
  "devDependencies": {
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-shell": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-session-projection": "workspace:*"
  }
}
