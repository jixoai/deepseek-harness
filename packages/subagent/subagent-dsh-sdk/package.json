{
  "name": "@fde2e/len-subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child FDE2E LEN runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-sdk-client": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-subagent": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*"
  },
  "dependencies": {
    "@fde2e/len-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-instructions": "workspace:*",
    "@fde2e/len-app-boot": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-llm-deepseek": "workspace:*",
    "@fde2e/len-llm-deepseek-api-key": "workspace:*",
    "@fde2e/len-loader-smoke": "workspace:*",
    "@fde2e/len-sdk-client": "workspace:*",
    "@fde2e/len-sdk-protocol": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-checkpoint-policy": "workspace:*",
    "@fde2e/len-session-persistence-jsonl": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-skill-filesystem": "workspace:*",
    "@fde2e/len-subagent": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-tool-subagent": "workspace:*"
  }
}
