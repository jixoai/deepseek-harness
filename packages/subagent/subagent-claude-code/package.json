{
  "name": "@fde2e/len-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-subagent": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-timeout": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@fde2e/len-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "4.4.3",
    "@fde2e/len-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-app-boot": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-loader-smoke": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-checkpoint-policy": "workspace:*",
    "@fde2e/len-session-persistence-jsonl": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-subagent": "workspace:*",
    "@fde2e/len-subagent-codex": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-subprocess-local": "workspace:*",
    "@fde2e/len-timeout": "workspace:*",
    "@fde2e/len-tool-jobs": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*"
  },
  "icon": "./icon.svg"
}
