{
  "name": "@fde2e/len-client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./assets/*": "./lib/assets/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@fde2e/len-api-session-controller",
        "@fde2e/len-api-workspace-controller",
        "@fde2e/len-client-connection",
        "@fde2e/len-client-locale",
        "@fde2e/len-client-ui-conversation",
        "@fde2e/len-client-ui-input-trigger",
        "@fde2e/len-client-ui-layout",
        "@fde2e/len-client-ui-renderer",
        "@fde2e/len-client-ui-session",
        "@fde2e/len-client-ui-settings",
        "@fde2e/len-client-ui-sidebar-right",
        "@fde2e/len-client-ui-workspace",
        "@fde2e/len-client-ui-file-drag",
        "@fde2e/len-client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-api-remotes": "workspace:*",
    "@fde2e/len-api-session-controller": "workspace:*",
    "@fde2e/len-api-workspace-controller": "workspace:*",
    "@fde2e/len-api-workspace-files": "workspace:*",
    "@fde2e/len-attachment": "workspace:*",
    "@fde2e/len-brand": "workspace:*",
    "@fde2e/len-client-connection": "workspace:*",
    "@fde2e/len-client-locale": "workspace:*",
    "@fde2e/len-client-store": "workspace:*",
    "@fde2e/len-client-ui-approval": "workspace:*",
    "@fde2e/len-client-ui-conversation": "workspace:*",
    "@fde2e/len-client-ui-input-trigger": "workspace:*",
    "@fde2e/len-client-ui-layout": "workspace:*",
    "@fde2e/len-client-ui-primitives": "workspace:*",
    "@fde2e/len-client-ui-renderer": "workspace:*",
    "@fde2e/len-client-ui-session": "workspace:*",
    "@fde2e/len-client-ui-settings": "workspace:*",
    "@fde2e/len-client-ui-sidebar-browser": "workspace:*",
    "@fde2e/len-client-ui-sidebar-documentpreview": "workspace:*",
    "@fde2e/len-client-ui-sidebar-right": "workspace:*",
    "@fde2e/len-client-ui-slots": "workspace:*",
    "@fde2e/len-client-ui-workspace": "workspace:*",
    "@fde2e/len-commands": "workspace:*",
    "@fde2e/len-compaction": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-llm-retry": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-stats": "workspace:*",
    "@fde2e/len-session-turn-outline": "workspace:*",
    "@fde2e/len-subagent": "workspace:*",
    "@fde2e/len-token-meter": "workspace:*",
    "@fde2e/len-util-workspace-path": "workspace:*",
    "@fde2e/len-tool-executor-ptc": "workspace:*",
    "@fde2e/len-util-values": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@fde2e/len-settings": "workspace:*",
    "@fde2e/len-client-product-analytics": "workspace:*",
    "@fde2e/len-client-ui-file-drag": "workspace:*",
    "@fde2e/len-client-ui-context-menu": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/assets",
    "lib/types/**/*.d.ts"
  ]
}
