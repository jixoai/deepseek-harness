{
  "name": "@fde2e/len-client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@fde2e/len-api-session-controller",
        "@fde2e/len-client-file-upload",
        "@fde2e/len-client-locale",
        "@fde2e/len-client-ui-layout",
        "@fde2e/len-client-ui-renderer",
        "@fde2e/len-client-ui-session",
        "@fde2e/len-client-ui-settings",
        "@fde2e/len-client-ui-workspace",
        "@fde2e/len-client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-api-remotes": "workspace:*",
    "@fde2e/len-api-session-controller": "workspace:*",
    "@fde2e/len-api-workspace-controller": "workspace:*",
    "@fde2e/len-attachment": "workspace:*",
    "@fde2e/len-brand": "workspace:*",
    "@fde2e/len-client-locale": "workspace:*",
    "@fde2e/len-client-file-upload": "workspace:*",
    "@fde2e/len-client-store": "workspace:*",
    "@fde2e/len-client-test-runtime": "workspace:*",
    "@fde2e/len-client-ui-layout": "workspace:*",
    "@fde2e/len-client-ui-primitives": "workspace:*",
    "@fde2e/len-client-ui-renderer": "workspace:*",
    "@fde2e/len-client-ui-session": "workspace:*",
    "@fde2e/len-client-ui-settings": "workspace:*",
    "@fde2e/len-client-ui-workspace": "workspace:*",
    "@fde2e/len-client-ui-slots": "workspace:*",
    "@fde2e/len-commands": "workspace:*",
    "@fde2e/len-goal": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-llm-retry": "workspace:*",
    "@fde2e/len-plan-mode": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-util-values": "workspace:*",
    "@fde2e/len-token-meter": "workspace:*",
    "@fde2e/len-tool-todo": "workspace:*",
    "@fde2e/len-util-crypto": "workspace:*",
    "@fde2e/len-workspace": "workspace:*",
    "@fde2e/len-file-reference": "workspace:*",
    "@fde2e/len-util-workspace-path": "workspace:*",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "zod": "4.4.3",
    "lexical": "^0.49.0",
