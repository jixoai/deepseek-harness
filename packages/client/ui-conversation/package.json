    "@lexical/history": "^0.49.0",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-settings": "workspace:*",
    "@fde2e/len-client-shortcuts": "workspace:*",
    "@fde2e/len-client-product-analytics": "workspace:*",
