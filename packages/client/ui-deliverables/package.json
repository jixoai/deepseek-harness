{
  "name": "@fde2e/len-client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-deliverables"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@fde2e/len-api-remotes",
        "@fde2e/len-client-connection",
        "@fde2e/len-client-locale",
        "@fde2e/len-client-ui-chat",
        "@fde2e/len-client-ui-conversation",
        "@fde2e/len-client-ui-renderer",
        "@fde2e/len-client-ui-sidebar-right",
        "@fde2e/len-client-ui-tool",
        "@fde2e/len-client-ui-settings",
        "@fde2e/len-client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@fde2e/len-api-remotes": "workspace:*",
    "@fde2e/len-client-connection": "workspace:*",
    "@fde2e/len-client-locale": "workspace:*",
    "@fde2e/len-client-store": "workspace:*",
    "@fde2e/len-client-test-runtime": "workspace:*",
    "@fde2e/len-client-ui-chat": "workspace:*",
    "@fde2e/len-client-ui-conversation": "workspace:*",
    "@fde2e/len-client-ui-dockkit": "workspace:*",
    "@fde2e/len-client-ui-renderer": "workspace:*",
    "@fde2e/len-client-ui-sidebar-right": "workspace:*",
    "@fde2e/len-client-ui-slots": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "react": "^18.2.0",
    "@fde2e/len-client-ui-primitives": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-session-query": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-client-ui-tool": "workspace:*",
    "@fde2e/len-tool-present": "workspace:*",
    "@fde2e/len-workspace-changes": "workspace:*",
    "@fde2e/len-api-session-controller": "workspace:*",
    "@fde2e/len-util-values": "workspace:*",
    "@fde2e/len-util-workspace-path": "workspace:*",
    "@fde2e/len-api-workspace-files": "workspace:*",
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-fs-local": "workspace:*",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-sandbox-policy": "workspace:*",
    "@fde2e/len-client-ui-settings": "workspace:*",
    "@fde2e/len-client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@fde2e/len-typert-protocol": "workspace:*"
  }
}
