{
  "name": "@fde2e/len-lsp-stdio",
  "description": "Generic stdio language-server provider for the FDE2E LEN LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-brand": "workspace:*",
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-lsp": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-timeout": "workspace:*"
  },
  "dependencies": {
    "@fde2e/len-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-brand": "workspace:*",
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-fs-local": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-lsp": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-subprocess-local": "workspace:*",
    "@fde2e/len-timeout": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
