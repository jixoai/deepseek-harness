{
  "name": "@fde2e/len-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the FDE2E LEN",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-scope": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-typert-protocol": "workspace:*",
    "@fde2e/len-util-values": "workspace:*",
    "@fde2e/len-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@fde2e/len-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-scope": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-typert-protocol": "workspace:*",
    "@fde2e/len-typert-registry": "workspace:*",
    "@fde2e/len-util-values": "workspace:*",
    "@fde2e/len-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@fde2e/len-brand": "workspace:*",
    "zod": "4.4.3"
  }
}
