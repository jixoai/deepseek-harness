{
  "name": "@fde2e/len-attachment-local",
  "description": "Private content-addressed DSH_HOME attachment storage",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/attachment/attachment-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@fde2e/len-attachment": "workspace:*",
    "@fde2e/len-home-paths": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@fde2e/len-lazy-require": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@fde2e/len-attachment": "workspace:*",
    "@fde2e/len-home-paths": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
