{
  "name": "@fde2e/len-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop": "workspace:*",
    "@fde2e/len-attachment-local": "workspace:*",
    "@fde2e/len-compaction-basic": "workspace:*",
    "@fde2e/len-compaction-image-offload": "workspace:*",
    "@fde2e/len-deepseek-llm-api-extensions": "workspace:*",
    "@fde2e/len-jobs-local": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-llm-deepseek-api-key": "workspace:*",
    "@fde2e/len-llm-retry": "workspace:*",
    "@fde2e/len-mcp-resources": "workspace:*",
    "@fde2e/len-plugin-package-inventory-deepseek": "workspace:*",
    "@fde2e/len-sandbox-local": "workspace:*",
    "@fde2e/len-sandbox-policy": "workspace:*",
    "@fde2e/len-sdk-app": "workspace:*",
    "@fde2e/len-sdk-jsonrpc-server": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-checkpoint-policy": "workspace:*",
    "@fde2e/len-session-log-deepseek": "workspace:*",
    "@fde2e/len-session-persistence-jsonl": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-session-title": "workspace:*",
    "@fde2e/len-subprocess-local": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-terminal": "workspace:*",
    "@fde2e/len-terminal-bash": "workspace:*",
    "@fde2e/len-token-meter": "workspace:*",
    "@fde2e/len-tool-bash-persistent": "workspace:*",
    "@fde2e/len-tool-executor-native": "workspace:*",
    "@fde2e/len-tool-fs": "workspace:*",
    "@fde2e/len-tool-pwsh-persistent": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-working-directory": "workspace:*",
    "@fde2e/len-tool-working-directory": "workspace:*",
    "@fde2e/len-fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
