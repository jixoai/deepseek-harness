{
  "name": "@fde2e/len-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the FDE2E LEN web capability seam (ctx.web)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-web": "workspace:*"
  },
  "dependencies": {
    "@fde2e/len-output-retention": "workspace:*",
    "@fde2e/len-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-spill-local": "workspace:*",
    "@fde2e/len-spill-policy": "workspace:*",
    "@fde2e/len-system-prompt": "workspace:*",
    "@fde2e/len-tool-call-timeout-policy": "workspace:*",
    "@fde2e/len-tool-executor-native": "workspace:*",
    "@fde2e/len-tool-testkit": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-web": "workspace:*",
    "@fde2e/len-web-deepseek-api": "workspace:*",
    "@fde2e/len-web-fetch-http": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@fde2e/len-scope": "workspace:*",
    "@fde2e/len-token-meter": "workspace:*",
    "@fde2e/len-launch-environment": "workspace:*"
  }
}
