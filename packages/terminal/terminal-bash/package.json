{
  "name": "@fde2e/len-terminal-bash",
  "description": "Persistent shell PTY backend over the DeepSeek Harness subprocess terminal primitive",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-terminal": "workspace:*",
    "@fde2e/len-sandbox": "workspace:*",
    "@fde2e/len-sandbox-policy": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-working-directory": "workspace:*"
  },
  "dependencies": {
    "@fde2e/len-lazy-require": "workspace:*",
    "@fde2e/len-pwsh-local": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-terminal": "workspace:*",
    "@fde2e/len-sandbox": "workspace:*",
    "@fde2e/len-sandbox-policy": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-subprocess": "workspace:*",
    "@fde2e/len-subprocess-local": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-working-directory": "workspace:*"
  }
}
