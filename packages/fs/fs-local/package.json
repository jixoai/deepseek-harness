{
  "name": "@fde2e/len-fs-local",
  "description": "Local-filesystem implementation of the FDE2E LEN filesystem seam (ctx.fs)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@fde2e/len-fs": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "koffi": "3.1.1",
    "@deepseek-ai/schemastery": "workspace:~",
    "@fde2e/len-fs-patch": "workspace:*"
  },
  "devDependencies": {
    "@fde2e/len-fs": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
