{
  "name": "@fde2e/len-acp",
  "description": "Automation-only Agent Client Protocol server for driving FDE2E LEN agents over JSON-RPC stdio",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@fde2e/len-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-attachment": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-mcp-client": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-persistence": "workspace:*",
    "@fde2e/len-token-meter": "workspace:*",
    "@fde2e/len-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@fde2e/len-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@fde2e/len-agent": "workspace:*",
    "@fde2e/len-agent-loop": "workspace:*",
    "@fde2e/len-agent-loop-testkit": "workspace:*",
    "@fde2e/len-attachment": "workspace:*",
    "@fde2e/len-llm": "workspace:*",
    "@fde2e/len-mcp-client": "workspace:*",
    "@fde2e/len-session": "workspace:*",
    "@fde2e/len-session-persistence": "workspace:*",
    "@fde2e/len-session-persistence-jsonl": "workspace:*",
    "@fde2e/len-session-projection": "workspace:*",
    "@fde2e/len-subagent": "workspace:*",
    "@fde2e/len-token-meter": "workspace:*",
    "@fde2e/len-tool-testkit": "workspace:*",
    "@fde2e/len-tools": "workspace:*",
    "@fde2e/len-user-approval": "workspace:*"
  }
}
